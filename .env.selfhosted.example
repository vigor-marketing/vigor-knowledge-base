# 企业知识库｜自托管环境变量示例
# 用法：复制为 .env.selfhosted，仅在其中填写真实密钥，并执行 chmod 600 .env.selfhosted。
# 该文件只用于本地/单机部署；生产环境应通过密钥管理服务或实例角色注入，不落盘。

# ---------------------------------------------------------------------------
# 服务基础
# ---------------------------------------------------------------------------
# API 监听端口（docker-compose 已固定为 4180）
PORT=4180
# 反向代理下的访问前缀
APP_BASE_PATH=/apps/knowledge-base/
# 单个上传文件大小上限（字节），默认 50MB
MAX_UPLOAD_BYTES=52428800

# ---------------------------------------------------------------------------
# MySQL（专属实例，先执行 database/schema.sql）
# ---------------------------------------------------------------------------
MYSQL_URL=mysql://knowledge_base:CHANGE_ME@mysql:3306/knowledge_base
# docker-compose 初始化时使用的密码（与 MYSQL_URL 保持一致）
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT

# ---------------------------------------------------------------------------
# Redis / BullMQ（入库、索引与下架队列）
# ---------------------------------------------------------------------------
REDIS_URL=redis://:CHANGE_ME@redis:6379/0
REDIS_PASSWORD=CHANGE_ME

# ---------------------------------------------------------------------------
# Qdrant 向量索引（混合检索）
# ---------------------------------------------------------------------------
QDRANT_URL=http://qdrant:6333
# 集合名称，默认 knowledge_chunks_v1
# QDRANT_INDEX=knowledge_chunks_v1

# ---------------------------------------------------------------------------
# Embedding 服务（bge-m3 兼容）
# ---------------------------------------------------------------------------
EMBEDDING_API_URL=https://embedding.example.com/v1
EMBEDDING_API_KEY=CHANGE_ME
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024

# ---------------------------------------------------------------------------
# DeepSeek（仅用于有证据的最终回答）
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=CHANGE_ME
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# ---------------------------------------------------------------------------
# 工作台 OIDC（令牌 sub 必须为 usr_...；管理员角色 general_manager / admin_specialist）
# ---------------------------------------------------------------------------
OIDC_ISSUER=https://workbench.example.com
OIDC_AUDIENCE=knowledge-base
OIDC_JWKS_URI=https://workbench.example.com/oidc/jwks

# ---------------------------------------------------------------------------
# 腾讯云 COS（资料原件，专用 Bucket）
# ---------------------------------------------------------------------------
COS_BUCKET=CHANGE_ME-1234567890
COS_REGION=ap-guangzhou
COS_PREFIX=knowledge-base
TENCENTCLOUD_SECRET_ID=CHANGE_ME
TENCENTCLOUD_SECRET_KEY=CHANGE_ME

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------
# 入库 Worker 并发数，默认 2
# WORKER_CONCURRENCY=2
